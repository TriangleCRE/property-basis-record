# Copy to .env and fill in for local development.
# In Vercel, DATABASE_URL is already set by the Postgres/Neon storage
# integration — nothing to configure there. PASSCODE must still be set
# manually as a Vercel project environment variable (it's a secret, not
# something the storage integration provides).
DATABASE_URL=postgres://user:password@localhost:5432/property_basis_record
PASSCODE=choose-a-passcode-for-local-testing
